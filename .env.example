# Copy to .env.local for development, and add the same values in the Vercel project settings.

# Resend API key — create one at https://resend.com/api-keys (sending access is enough).
RESEND_API_KEY=

# Where contact-form messages are delivered.
CONTACT_TO_EMAIL=cuadra.jkyle@gmail.com

# The sender. The domain must be verified in Resend, otherwise every send is rejected.
CONTACT_FROM_EMAIL="jkcuadra portfolio <noreply@portfolio.khayll-labs.com>"

# Google Search Console "HTML tag" verification — paste only the content="..." value. Leave empty if
# you verify the domain through a DNS TXT record instead.
GOOGLE_SITE_VERIFICATION=

# Canonical origin for metadata, the sitemap and social cards. Normally leave this empty: on Vercel it
# resolves to the production domain, including a custom one. Set it only to force a different origin.
NEXT_PUBLIC_SITE_URL=
