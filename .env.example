# Copy to .env.local for development, and add the same values in the Vercel project settings.

# Resend API key — create one at https://resend.com/api-keys (sending access is enough).
RESEND_API_KEY=

# Where contact-form messages are delivered.
CONTACT_TO_EMAIL=cuadra.jkyle@gmail.com

# The sender. The domain must be verified in Resend, otherwise every send is rejected.
CONTACT_FROM_EMAIL="jkcuadra portfolio <noreply@portfolio.khayll-labs.com>"

# Canonical origin for metadata, the sitemap and social cards. On Vercel this falls back to the
# project's production URL automatically — set it explicitly once a custom domain is attached.
NEXT_PUBLIC_SITE_URL=
